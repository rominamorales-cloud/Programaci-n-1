#Clase autor
class Autor:
#Datos del autor
    def __init__(self, nombre):
        self.nombre = nombre
        self.libros = []
#Agregar un libro
def agregar_libro(self, libro):
    self.libros.append(libro)
#Eliminar un libro
def eliminar_libro(self, libro):
    if libro in self.libros:
        self.libros.remove(libro)
        print(f"El libro {libro} fue eliminado.")
    else:
        print(f"El libro {libro} no se encuentra en la lista.")
#Muestra los libros
def mostrar_libros(self):
    print(f"Libros de {self.nombre}:")
    for libro in self.libros:
        print("-", libro)
#PRUEBA
autor = Autor("Autor de los libros")
autor.agregar_libro ("Vocación y pueblo: Médicos de Isla Mala")
autor.agregar_libro("Mil quinientos días en la cárcel por error")
autor.agregar_libro("Moiras")
autor.agregar_libro("Roger Federer")
autor.mostrar_libros()
autor.eliminar_libro("Roger Federer")
autor.mostrar_libros()