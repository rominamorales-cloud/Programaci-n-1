#Solución
# Lista que almacena los libros
biblioteca = []
#Agregar libro
def agregar_libro(titulo):
    biblioteca.append(titulo)
print(f'Libro "{titulo}" agregado correctamente.')
#Eliminar libro
def eliminar_libro(titulo):
    if titulo in biblioteca:
        biblioteca.remove(titulo)
        print(f'Libro"{titulo}" eliminado correctamente.')
    else:
        print(f'El libro "{titulo}" no se encuentra en la biblioteca.')
#Buscar un libro por título
def buscar_libro(titulo):
    if titulo in biblioteca:
        print(f'El libro "{titulo}" está disponible.')
        return True
    else:
        print(f'El libro "{titulo}" no está disponible.')
        return False
#Mostrar todos los libros disponibles
    def mostrar_libros():
        if len(biblioteca) == 0:
            print("No hay libros disponibles.")
        else:
            print("\nLibros disponibles:")
for libro in biblioteca:
    print("-", libro)

