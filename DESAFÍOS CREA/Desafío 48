#Clase Autor
class Autor:
#Datos del autor
    def __init__(self, nombre):
            self.nombre = nombre
            self.libros = []
#Agregar un libro
    def agregar_libro(self, libro):
        self.libros.append(libro)
#Eliminar un libro
def eliminar_libro(self, libro):
    if libro in self.libros:
        self.libros.remove(libro)
        print(f"El libro {libro.titulo} fue eliminado.")
    else:
        print("El libro no se encuentra en la lista.")
#Mostrar los libros del autor
def mostrar_autor(self):
    print(f"Libros de {self.nombre}:")
for libro in self.libros: # type: ignore
    print("-", libro.titulo)
#Clase Libro
class Libro:
#Datos del libro
    def __init__(self, titulo, genero, isbn, autor):
        self.titulo = titulo
        self.genero = genero
        self.isbn = isbn
        self.autor = autor
