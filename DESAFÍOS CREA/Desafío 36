def negrita(texto):
    #Se agrega dos asteriscos a cada lado del texto.
    return f"**{texto}**"

def italica(texto):
    #Se agrega un asterisco a cada lado del texto.
    return f"*{texto}*"

def subrayado(texto):
    #Se utiliza etiquetas HTML para subrayar el texto.
    return f"<u>{texto}</u>"
