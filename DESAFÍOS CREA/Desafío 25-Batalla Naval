import numpy as np

import random

# Crea tablero 5x5

tablero = np.zeros((5,5), dtype=int)

#Coloca 3 barcos en posiciones aleatorias

barcos = 0

while barcos < 3:

    x = random.randint(0,4)
    y = random.randint(0,4)
    if tablero[x,y] == 0:

        tablero[x,y] = 1
        barcos += 1

#Función para verificar un disparo
def disparar(x, y):

    if tablero[x,y] == 1:

        print("¡Atención! Impacto en el barco.")

    else:

        print("El disparo cayó al agua.")

#Prueba 
disparar(1, 3)